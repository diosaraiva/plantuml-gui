footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Class Diagram - Order Domain

' ---- Elements ----
package "Domain" {
  abstract class Person {
    - id : UUID
    # name : String
    + {abstract} getRole() : String
  }

  class Customer {
    - email : String
    + placeOrder(cart : Cart) : Order
  }

  class Employee {
    - department : String
    + getRole() : String
  }

  class Order {
    - number : int
    - status : OrderStatus
    + {static} nextNumber() : int
    + total() : Money
    + cancel() : void
  }

  class OrderLine {
    - quantity : int
    + subtotal() : Money
  }

  class Product {
    - sku : String
    - price : Money
  }

  class Catalog

  class Review {
    - rating : int
    - comment : String
  }

  enum OrderStatus {
    NEW
    PAID
    SHIPPED
    CANCELLED
  }

  interface Payable <<interface>> {
    + pay(amount : Money) : boolean
  }
}

package "Infrastructure" {
  class Repository<T> {
    + findById(id : UUID) : T
    + save(entity : T) : void
  }
  class OrderRepository
  class OrderService <<service>>
}

Person <|-- Customer
Person <|-- Employee
Customer "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderLine : contains
OrderLine "0..*" --> "1" Product : refers to
Catalog "1" o-- "0..*" Product : lists
Order ..|> Payable
Order --> OrderStatus
Repository <|.. OrderRepository : <<bind>> T->Order
OrderService ..> OrderRepository : <<use>>
OrderService ..> Order : <<use>>
(Customer, Product) .. Review

note right of Order : Aggregate root

@enduml