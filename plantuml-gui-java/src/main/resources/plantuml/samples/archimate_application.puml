@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Application Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Application_Component(shop, "Shop Application")
Application_Component(billing, "Billing Application")
Application_Collaboration(commerce, "Commerce Platform")
Application_Interface(api, "REST API")
Application_Service(orderSvc, "Order Management Service")
Application_Function(calc, "Calculate Totals")
Application_Process(checkout, "Checkout Process")
Application_Interaction(sync, "Sync Orders")
Application_Event(placed, "Order Placed")
Application_DataObject(orderData, "Order Data")

Rel_Composition(shop, api, "exposes")
Rel_Realization(shop, orderSvc, "realizes")
Rel_Assignment(shop, calc, "performs")
Rel_Triggering(placed, checkout, "triggers")
Rel_Flow(shop, billing, "sends order")
Rel_Access_rw(checkout, orderData, "reads/writes")
Rel_Aggregation(commerce, shop, "includes")
Rel_Aggregation(commerce, billing, "includes")
Rel_Assignment(commerce, sync, "performs")

@enduml