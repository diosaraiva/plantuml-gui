@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Physical Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Physical_Facility(dc, "Data Center")
Physical_Equipment(rack, "Server Rack")
Physical_Equipment(sorter, "Parcel Sorter")
Physical_Material(parcel, "Customer Parcel")
Physical_DistributionNetwork(logistics, "Delivery Network")
Technology_Device(server, "Rack Server")

Rel_Composition(dc, rack, "contains")
Rel_Realization(server, rack, "hosted on")
Rel_Access_rw(sorter, parcel, "handles")
Rel_Association(logistics, sorter, "uses")

@enduml