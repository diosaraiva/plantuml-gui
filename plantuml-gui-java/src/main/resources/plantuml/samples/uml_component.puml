@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://plantuml.com/component-diagram

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Component Diagram - Shop Platform

' ---- Elements ----
package "Shop Platform" {
  component "Web UI" as ui <<UI>>

  component "Order Service" as orders <<service>> {
    portin "http" as ordersIn
    portout "db" as ordersDb
  }

  component "Billing Service" as billing <<service>>
  component "Notification Service" as notif <<service>>

  interface "IOrder" as iorder
  interface "IBilling" as ibilling
  interface "INotify" as inotify
}

database "Orders DB" as db
cloud "Payment Gateway" as gateway

' provided interfaces (lollipop)
ordersIn -() iorder
billing -() ibilling
notif -() inotify

' required interfaces (socket)
ui ..> iorder : uses
orders ..> ibilling : uses
orders ..> inotify : uses

ordersDb --> db : JDBC
billing --> gateway : HTTPS

@enduml