@startuml
!pragma layout smetana

title UML Deployment Diagram

' ---- Customizations ----
skinparam legendBackgroundColor #white
skinparam legendBorderColor #white
skinparam legendFontSize 10

' ---- Elements ----
node "Web Server" as web {
  artifact "webapp.war"
}

node "App Server" as app {
  artifact "api.jar"
  artifact "worker.jar"
}

node "Database Server" as db {
  database "PostgreSQL" as pg
}

cloud "CDN" as cdn

actor User

' ---- Relations ----
User --> cdn : HTTPS
cdn --> web
web --> app : REST API
app --> pg : JDBC

legend
|= Info |= Description |
| Reference | https://plantuml.com/deployment-diagram |
endlegend

@enduml