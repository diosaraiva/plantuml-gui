@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://plantuml.com/deployment-diagram

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Deployment Diagram - Production

' ---- Elements ----
node "Client Device" <<device>> as client {
  node "Browser" <<execution environment>> as browser {
    artifact "shop-spa.js" as spa
  }
}

node "App Server" <<device>> as app {
  node "JVM" <<execution environment>> as jvm {
    artifact "shop.war" as war
    artifact "application.yml" as cfg
  }
}

node "DB Server" <<device>> as dbsrv {
  database "PostgreSQL" as pg
}

cloud "Payment Gateway" as pay

war ..> cfg : <<manifest>>
spa --> war : HTTPS / JSON
war --> pg : JDBC
war --> pay : HTTPS

@enduml