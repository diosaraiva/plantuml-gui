@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://plantuml.com/sequence-diagram

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Sequence Diagram - Online Checkout

' ---- Elements ----
autonumber

actor Customer
boundary "Web UI" as UI
control "Order Controller" as Ctrl
entity Order
database "Orders DB" as DB
queue "Event Bus" as Bus
participant "Payment Gateway" as Pay <<external>>

Customer -> UI : click "Pay"
activate UI
UI -> Ctrl : checkout(cartId)
activate Ctrl

Ctrl -> Order ** : create(cart)
Ctrl -> DB : insert(order)
DB --> Ctrl : orderId

ref over Ctrl, Pay : Fraud check

group Payment
  Ctrl -> Pay : charge(amount)
  activate Pay
  alt approved
    Pay --> Ctrl : OK
    Ctrl ->> Bus : publish(OrderPaid)
    note right of Bus : asynchronous message
  else declined
    Pay --> Ctrl : DECLINED
    Ctrl -> Order : cancel()
    Order -> Order : markCancelled()
  end
  deactivate Pay
end

opt receipt requested
  par
    Ctrl ->> Bus : publish(SendReceipt)
  else
    Ctrl ->> Bus : publish(UpdateStats)
  end
end

loop up to 3 times
  UI -> Ctrl : pollStatus(orderId)
  Ctrl --> UI : status
end

Ctrl --> UI : result
deactivate Ctrl
UI --> Customer : confirmation
deactivate UI

destroy Order

@enduml