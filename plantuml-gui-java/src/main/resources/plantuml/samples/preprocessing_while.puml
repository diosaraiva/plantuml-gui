@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>
!pragma layout smetana

header Reference: https://plantuml.com/preprocessing

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui

title Preprocessing - Loops with !while

' ---- Elements ----
!procedure $foo($arg)
  :procedure start;
  !while $arg!=0
    !$i=3
    :arg=$arg; <<#palegreen>>
    !while $i!=0
      :arg=$arg and i=$i;
      !$i = $i - 1
    !endwhile
    !$arg = $arg - 1
  !endwhile
  :procedure end;
!endprocedure

start
$foo(2)
end

@enduml