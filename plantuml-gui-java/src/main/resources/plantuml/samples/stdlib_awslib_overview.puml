@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/awslabs/aws-icons-for-plantuml

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title AWS Diagram

' ---- Includes ----
!include <awslib/AWSCommon>
!include <awslib/General/Users>
!include <awslib/Groups/AWSCloud>
!include <awslib/Groups/VPC>
!include <awslib/Groups/PublicSubnet>
!include <awslib/Groups/PrivateSubnet>
!include <awslib/NetworkingContentDelivery/VPCInternetGateway>
!include <awslib/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer>
!include <awslib/Compute/EC2>
!include <awslib/Database/RDS>
!include <awslib/Storage/SimpleStorageService>

' ---- Elements ----
Users(users, "Internet Users", "HTTPS")

AWSCloudGroup(cloud) {
  SimpleStorageService(s3, "S3 Bucket", "Static assets")

  VPCGroup(vpc) {
    PublicSubnetGroup(pub, "Public Subnet") {
      VPCInternetGateway(igw, "Internet Gateway", "")
      ElasticLoadBalancingApplicationLoadBalancer(alb, "ALB", "HTTP/HTTPS")
    }
    PrivateSubnetGroup(priv, "Private Subnet") {
      EC2(ec2, "Web Server", "t3.micro")
      RDS(db, "Database", "MySQL")
    }
  }
}

users --> igw
igw --> alb
alb --> ec2
ec2 --> db
ec2 ..> s3

@enduml