@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Implementation and Migration Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Implementation_Plateau(baseline, "Baseline: On-Premises")
Implementation_Plateau(target, "Target: Cloud Native")
Implementation_Gap(gap, "Missing Container Platform")
Implementation_WorkPackage(migrate, "Migrate Workloads")
Implementation_Deliverable(runbook, "Cloud Runbook")
Implementation_Event(go, "Go-Live")

Rel_Triggering(baseline, target, "migrates to")
Rel_Association(gap, baseline, "")
Rel_Association(gap, target, "")
Rel_Realization(migrate, runbook, "produces")
Rel_Realization(runbook, target, "realizes")
Rel_Triggering(migrate, go, "ends with")

@enduml