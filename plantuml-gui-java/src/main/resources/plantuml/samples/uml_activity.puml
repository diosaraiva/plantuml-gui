@startuml
!pragma layout smetana

title UML Activity Diagram

' ---- Customizations ----
skinparam legendBackgroundColor #white
skinparam legendBorderColor #white
skinparam legendFontSize 10

' ---- Activities ----
start
:Receive order;
if (Payment valid?) then (yes)
  :Process payment;
  fork
    :Pack items;
  fork again
    :Send confirmation email;
  end fork
  :Ship order;
else (no)
  :Notify customer;
  :Cancel order;
endif
stop

legend
|= Info |= Description |
| Reference | https://plantuml.com/activity-diagram-legacy\n https://plantuml.com/activity-diagram-beta |
endlegend

@enduml