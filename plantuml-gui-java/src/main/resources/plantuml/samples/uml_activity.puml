  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://plantuml.com/activity-diagram-beta

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Activity Diagram - Order Fulfilment

' ---- Elements ----
|Customer|
start
:Submit order;

|System|
:Validate order;
if (Valid?) then (yes)
  :Reserve stock;
else (no)
  :Notify customer of error;
  stop
endif

:Request payment;

|Payment Gateway|
:Authorize card;

|System|
if (Approved?) then (yes)
  fork
    |Warehouse|
    :Pick items;
    :Pack items;
  fork again
    |System|
    :Generate invoice;
    :Send confirmation email;
  end fork

  |Warehouse|
  repeat
    :Attempt delivery;
  repeat while (Delivered?) is (no) not (yes)

  |Customer|
  :Receive order;
else (no)
  |System|
  :Release stock;
  :Cancel order;
endif

stop

note right
  Swimlanes are activity partitions.
  fork / end fork = fork and join nodes.
end note

@enduml