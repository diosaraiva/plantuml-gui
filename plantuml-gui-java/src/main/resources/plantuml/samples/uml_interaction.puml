  FontSize 32
}
</style>

header Reference: https://plantuml.com/activity-diagram-beta

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Interaction Overview Diagram - Checkout Flow (approximated)

' ---- Elements ----
start

:ref sd Authenticate;

if (Authenticated?) then (yes)
  :ref sd Build Cart;
  :ref sd Fraud Check;
  if (Risk level?) then (low)
    fork
      :ref sd Charge Card;
    fork again
      :ref sd Reserve Stock;
    end fork
    :ref sd Send Confirmation;
  else (high)
    :ref sd Manual Review;
  endif
else (no)
  :ref sd Show Login Error;
endif

stop

@enduml