header Reference: https://plantuml.com/state-diagram

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML State Machine Diagram - Order Lifecycle

' ---- Elements ----
[*] --> Created

state Created : entry / validate()
state Created : exit / audit()

state stockCheck <<choice>>

state Fulfilment {
  [*] --> Picking
  Picking --> Packing : items picked
  Packing --> Packed
  --
  [*] --> Invoicing
  Invoicing --> Invoiced : invoice sent
}

Created --> Paid : paymentReceived / emitPaid()
Created --> Cancelled : cancel [not paid]

Paid --> stockCheck
stockCheck --> Fulfilment : [stock available]
stockCheck --> Backordered : [no stock]

Backordered --> stockCheck : restocked

Fulfilment --> OnHold : hold
OnHold --> Fulfilment[H] : resume

Fulfilment --> Shipped : shipped after(2d)
Shipped --> Delivered : delivered
Shipped --> Returned : return requested

Delivered --> [*]
Returned --> [*]
Cancelled --> [*]

@enduml