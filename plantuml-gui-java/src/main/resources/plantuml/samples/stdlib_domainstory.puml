header Reference: https://github.com/johthor/DomainStory-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title Domain Story - Booking Cinema Tickets

' ---- Includes ----
!include <DomainStory/domainStory>

' ---- Elements ----
Boundary(Cinema) {
    Person(Customer)
    Conversation(request)
    Person(Cashier)
    Conversation(offer)
}

activity(1, Customer, asks for, request, with, Cashier)
activity(2, Cashier, recommends, offer, to, Customer)
activity(3, Customer, confirms, offer, with, Cashier)

@enduml