@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Business Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Business_Actor(customer, "Customer")
Business_Role(buyer, "Buyer")
Business_Interface(web, "Web Storefront")
Business_Service(orderSvc, "Order Service")
Business_Process(orderProc, "Handle Order")
Business_Function(sales, "Sales")
Business_Event(received, "Order Received")
Business_Object(order, "Order")
Business_Contract(terms, "Terms of Sale")
Business_Product(product, "Online Subscription")

Rel_Assignment(customer, buyer, "plays")
Rel_Assignment(buyer, web, "uses")
Rel_Serving(orderSvc, buyer, "serves")
Rel_Realization(orderProc, orderSvc, "realizes")
Rel_Triggering(received, orderProc, "triggers")
Rel_Assignment(sales, orderProc, "performs")
Rel_Access_rw(orderProc, order, "reads/writes")
Rel_Aggregation(product, terms, "includes")

@enduml