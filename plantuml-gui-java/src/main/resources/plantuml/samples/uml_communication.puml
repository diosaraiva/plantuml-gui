footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title UML Communication Diagram - Place Order (approximated)

' ---- Elements ----
object "cust : Customer" as cust <<actor>>
object "ui : WebUI" as ui
object "ctrl : OrderController" as ctrl
object "order : Order" as order
object "stock : Inventory" as stock
object "pay : PaymentClient" as pay

cust --> ui : 1: submit()
ui --> ctrl : 1.1: placeOrder(cart)
ctrl --> order : 1.1.1: create(cart)
ctrl --> stock : 1.1.2: reserve(items)
ctrl --> pay : 1.1.3: charge(total)
ctrl --> order : 1.1.4: markPaid()
ctrl --> ui : 1.2: confirmation

@enduml