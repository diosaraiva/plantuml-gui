@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Motivation Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Motivation_Stakeholder(cio, "CIO")
Motivation_Driver(cost, "Rising Infrastructure Cost")
Motivation_Assessment(review, "Cloud Cost Review")
Motivation_Goal(reduce, "Reduce IT Cost")
Motivation_Outcome(saving, "20% Lower Run Cost")
Motivation_Principle(cloud, "Cloud First")
Motivation_Requirement(autoscale, "Autoscale Workloads")
Motivation_Constraint(budget, "Fixed Annual Budget")
Motivation_Meaning(meaning, "Cost Efficiency")
Motivation_Value(value, "Business Agility")

Rel_Association(cio, cost, "concerned with")
Rel_Influence(cost, review, "drives")
Rel_Influence(review, reduce, "informs")
Rel_Realization(saving, reduce, "realizes")
Rel_Realization(cloud, reduce, "supports")
Rel_Realization(autoscale, cloud, "realizes")
Rel_Influence(budget, autoscale, "limits")
Rel_Association(meaning, saving, "")
Rel_Association(value, reduce, "")

@enduml