@startuml
!pragma layout smetana
top to bottom direction
' Stereotypes only select the skinparam colours below; keep them off the diagram.
hide stereotype

skinparam BackgroundColor  #ffffff
skinparam DefaultFontName  Helvetica
skinparam DefaultFontSize  12
skinparam DefaultFontColor #2c3e50
skinparam ArrowThickness   1.5

' flows
skinparam arrow {
    FontColor        #495057
    FontSize         10
    MessageAlignment center
}

' boxes
skinparam component {
    BackgroundColor #cfffff
    BorderColor     #006080
    FontColor       #003040
    FontSize        11
    BorderThickness 1
    RoundCorner     0
}
skinparam rectangleBackgroundColor<<Actor>>                 #ffffcc
skinparam rectangleBorderColor<<Actor>>                     #c8a000
skinparam rectangleFontColor<<Actor>>                       #5a4500

skinparam componentBackgroundColor<<Application>>           #cfffff
skinparam componentBorderColor<<Application>>               #006080
skinparam componentFontColor<<Application>>                 #003040

skinparam componentBackgroundColor<<ApplicationComponent>>  #cfffff
skinparam componentBorderColor<<ApplicationComponent>>      #006080
skinparam componentFontColor<<ApplicationComponent>>        #003040

' group1
skinparam package {
    FontColor       #ffffff
    FontStyle       bold
    BorderThickness 2
    RoundCorner     0
}
skinparam packageBackgroundColor<<PkgBlue>>   #1a3a5c
skinparam packageBorderColor<<PkgBlue>>       #154360
skinparam packageBackgroundColor<<PkgGreen>>  #1e6b4a
skinparam packageBorderColor<<PkgGreen>>      #145a32

' group2
skinparam frame {
    BackgroundColor #f0f0f0
    BorderColor     #a0a0a0
    BorderThickness 1
    FontColor       #404040
    FontStyle       bold
    RoundCorner     0
}

' legend
skinparam legend {
    BorderColor      #ffffff
    BackgroundColor  #f8f9fa
    FontColor        #495057
    FontSize         10
}

' macros
!procedure Actor($alias, $stereotype, $label)
rectangle "<<$stereotype>>\n$label" as $alias <<Actor>>
!endprocedure

!procedure Component($type, $alias, $stereotype, $label)
component "<<$stereotype>>\n$label" as $alias <<$type>>
!endprocedure

!function Flow($stereotype, $label)
!return "<<" + $stereotype + ">>\n" + $label
!endfunction

!procedure Legend($col1, $col2)
| $col1 | $col2 |
!endprocedure

@enduml