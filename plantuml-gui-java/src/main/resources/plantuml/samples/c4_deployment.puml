@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/C4-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title C4 Deployment Diagram - Production

' ---- Includes ----
!include <C4/C4_Deployment>

' ---- Elements ----
Person(customer, "Customer", "Buys products online")

Deployment_Node(browser, "Customer's Browser", "Chrome, Firefox") {
  Container(spa, "Web Application", "React", "Storefront UI")
}

Deployment_Node(cloud, "Cloud Provider", "AWS") {
  Deployment_Node(app, "Application Server", "Ubuntu 22.04, Docker") {
    Container(api, "API Application", "Java, Spring Boot", "Business logic")
  }
  Deployment_Node(dbnode, "Database Server", "Managed RDS") {
    ContainerDb(db, "Database", "PostgreSQL", "Stores orders")
  }
}

Rel(customer, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads from and writes to", "JDBC")

SHOW_LEGEND()

@enduml