@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>

header Reference: https://github.com/plantuml-stdlib/Archimate-PlantUML

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui 

title ArchiMate - Technology Layer

' ---- Includes ----
!include <archimate/Archimate>

' ---- Elements ----
Technology_Node(cluster, "Application Cluster") {
  Technology_Device(server, "Linux Server")
  Technology_SystemSoftware(os, "Ubuntu 22.04")
  Technology_SystemSoftware(docker, "Docker Engine")
}
Technology_Node(dbNode, "Database Node")
Technology_CommunicationNetwork(lan, "Data Center LAN")
Technology_Path(link, "Replication Link")
Technology_Interface(jdbc, "JDBC Endpoint")
Technology_Collaboration(ha, "HA Pair")
Technology_Service(hosting, "Container Hosting Service")
Technology_Function(sched, "Schedule Containers")
Technology_Process(deploy, "Deploy Release")
Technology_Interaction(failover, "Failover")
Technology_Event(down, "Node Down")
Technology_Artifact(jar, "shop.jar")

Rel_Realization(docker, hosting, "realizes")
Rel_Assignment(docker, sched, "performs")
Rel_Triggering(down, failover, "triggers")
Rel_Assignment(jar, deploy, "deployed by")
Rel_Association(cluster, lan, "connected to")
Rel_Association(dbNode, lan, "connected to")
Rel_Composition(dbNode, jdbc, "exposes")
Rel_Association(link, ha, "")
Rel_Realization(jar, docker, "runs on")

@enduml