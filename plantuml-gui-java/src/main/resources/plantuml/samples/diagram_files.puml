@startuml
' ---- Customizations ----
<style>
title {
  HorizontalAlignment center
  FontSize 16
  FontColor black
}

header {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

footer {
  HorizontalAlignment center
  FontSize 12
  FontColor gray
}

legend {
  FontSize 12
  BackGroundColor white
}

caption {
  FontSize 32
}
</style>
!pragma layout smetana

header Reference: https://plantuml.com/files-diagram

footer PlantUML GUI: https://github.com/diosaraiva/plantuml-gui

title Files Diagram - Project File Structure

' ---- Elements ----
folder "project-root" {
  folder "src" {
    folder "main" {
      folder "java" {
        file "Main.java"
        file "Service.java"
      }
      folder "resources" {
        file "application.yml"
        file "logback.xml"
      }
    }
    folder "test" {
      file "ServiceTest.java"
    }
  }
  folder "docs" {
    file "architecture.puml"
    file "README.md"
  }
  file "build.gradle"
  file ".gitignore"
}

folder "output" {
  artifact "app.jar"
}

[project-root] --> [output] : build

@enduml